{
    "version": 2,
    "builds":[
        {
            "src": "api.py",
            "use": "@vercel/python"
        }
    ],
    "routes":[
        {
            "src":"/(.*)",
            "dest":"api.py"
        }
    ],
    "crons":[
        {
            "path":"/collect",
            "schedule":"*/15 9-15 * * 1-5"
        }
    ]   
}
